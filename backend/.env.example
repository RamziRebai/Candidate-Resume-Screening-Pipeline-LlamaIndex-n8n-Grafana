# ================================================================================
# N8N WEBHOOK INTEGRATION CONFIGURATION
# ================================================================================

# N8n webhook endpoint for RAG report processing
N8N_WEBHOOK_URL=http://localhost:5678/webhook/rag-report-processor

# N8n webhook configuration
N8N_WEBHOOK_TIMEOUT=30
N8N_WEBHOOK_MAX_RETRIES=3
N8N_WEBHOOK_ENABLED=true

# ================================================================================
# API KEYS
# ================================================================================

# LlamaParse Configuration
LLAMA_PARSE_API_KEY=<YOUR_LLAMA_PARSE_API_KEY>

# Qdrant Configuration
QDRANT_API_KEY=<YOUR_QDRANT_API_KEY>
QDRANT_URL=<YOUR_QDRANT_URL>
QDRANT_CLUSTER_ENDPOINT=<YOUR_QDRANT_CLUSTER_ENDPOINT>

# Google API Configuration
GOOGLE_API_KEY=<YOUR_GOOGLE_API_KEY>

# Azure OpenAI Configuration
AZURE_API_KEY=<YOUR_AZURE_API_KEY>
AZURE_ENDPOINT=<YOUR_AZURE_CHAT_COMPLETIONS_ENDPOINT>
AZURE_EMBED_ENDPOINT=<YOUR_AZURE_EMBEDDINGS_ENDPOINT>
AZURE_EMBED_API_KEY=<YOUR_AZURE_EMBED_API_KEY>

# ================================================================================
# APPLICATION CONFIGURATION
# ================================================================================

# Environment (development, production)
ENVIRONMENT=development

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

GOOGLE_DRIVE_FOLDER_ID=<YOUR_GOOGLE_DRIVE_FOLDER_ID>

# Logging Level
LOG_LEVEL=INFO
